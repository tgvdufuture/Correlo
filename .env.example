# ===== Correlo — variables d'environnement =====
# Copier ce fichier vers .env.local puis ajuster.
# Positionnement : local-first par défaut — embeddings locaux (Ollama) tant que
# EMBED_PROVIDER=ollama ; le chat part vers un endpoint distant UNIQUEMENT si
# LLM_CHAT_PROVIDER=groq (défaut).

# Chemin de la base SQLite (locale)
DATABASE_PATH=./data/correlo.db

# Provider du chat : "groq" (défaut) ou "ollama" — aucun fallback automatique
LLM_CHAT_PROVIDER=groq

# Requise uniquement si LLM_CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Endpoint chat OpenAI-compatible (défaut : https://api.groq.com/openai/v1).
# Un endpoint anonyme (ex. OVHcloud AI Endpoints) n'exige aucune clé : GROQ_API_KEY
# laissée vide ⇒ l'en-tête Authorization n'est pas envoyé.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Plafond de tokens de sortie. Recommandé sur le free tier Groq : sans lui, la sortie
# max du modèle est réservée contre la fenêtre TPM (8 000/min) → 429 en rafale.
GROQ_MAX_TOKENS=1600
# Effort de raisonnement demandé au modèle (low|medium|high). À NE PAS LAISSER VIDE
# avec un modèle de raisonnement : sans ce champ, `qwen/qwen3.8-27b` n'active pas son
# raisonnement et répond en 6 tokens le JSON le plus court possible ({"skip":true}),
# sans jamais lire les preuves. Mesuré : 10 thèmes → 10 skips ; avec `low`, ~1 000
# tokens de raisonnement par appel. Laisser vide pour un modèle non-raisonnant.
GROQ_REASONING_EFFORT=low
# Timeout d'un échange chat (secondes). Les modèles qui raisonnent (nemotron, gpt-oss)
# dépassent souvent 120 s : 300 s évite de tuer un batch et de consommer un attempt.
GROQ_CHAT_TIMEOUT_SECONDS=300

# Ollama (local) — embeddings locaux (EMBED_PROVIDER=ollama, le défaut)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ===== Connecteur d'embeddings =====
# "ollama" (défaut, local, 768 dims) ou "api" (endpoint OpenAI-compatible
# POST /embeddings, 2048 dims pour le modèle ci-dessous).
#
# L'espace vectoriel est un réglage DU CORPUS : les deux ne sont pas comparables.
# Après avoir changé cette valeur, re-vectoriser les fragments déjà en base :
#
#     npm run reembed          # même commande dans les deux sens (--dry-run pour voir)
#
# Tant que le corpus n'est pas aligné, l'analyse refuse de comparer les espaces
# (bandeau sur l'atelier) au lieu de produire des liens faux.
EMBED_PROVIDER=ollama
# Endpoint d'embeddings si EMBED_PROVIDER=api (NVIDIA NIM par défaut)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Dimensions RENDUES par le modèle (non négociables : 400 si autre valeur)
NVIDIA_EMBED_DIMENSIONS=2048
# "passage" (document indexé) | "query" | "off" (champ omis, certains services le refusent)
NVIDIA_EMBED_INPUT_TYPE=passage
# Textes par appel d'embeddings (mesuré : 32 en 2,7 s)
NVIDIA_EMBED_BATCH_SIZE=32
NVIDIA_EMBED_TIMEOUT_SECONDS=120

# Requis uniquement si LLM_CHAT_PROVIDER=ollama
OLLAMA_CHAT_MODEL=

# ===== Conversation (Phase 6) =====
# Étapes INTERNES d'un tour (plafond dur : 5, comme l'enquête de la Phase 4).
# Un tour = un job : le worker appelle le modèle une fois par étape, le serveur exécute
# l'action (recherche lexicale, voisinage d'embeddings), puis assemble la réponse à partir
# des affirmations — le modèle ne rend jamais de prose libre.
CONVERSATION_MAX_STEPS=5

# ===== Conversation : accès web (Phase 6, AC2′) =====
# L'agent décide d'aller sur le web, mais la DÉCISION est un constat serveur : les outils
# ne sont exposés au modèle que si le catalogue ne porte pas WEB_UNLOCK_MIN_EVIDENCE
# fragments utilisables issus d'au moins deux sources distinctes. Sinon ils n'existent pas
# dans sa liste — le corpus reste la valeur du produit.
#
# WEB_ACCESS=off retire les outils quel que soit le constat (rien ne sort, jamais).
# WEB_MAX_STEPS compte les étapes web EN PLUS des étapes internes (plafond dur : 3).
WEB_ACCESS=on
WEB_MAX_STEPS=3
WEB_UNLOCK_MIN_EVIDENCE=2
WEB_SEARCH_RESULTS=5

# Connecteur de recherche : "none" (défaut — les outils web n'existent pas, la Phase 6
# reste complète et hors ligne) ou "exa". Aucun fallback implicite.
SEARCH_PROVIDER=none
EXA_API_KEY=
# Toute page lue par l'agent est traitée comme une DONNÉE, jamais une instruction :
# http(s) seulement, adresses privées/bouclage/lien local refusées après résolution DNS et
# à chaque redirection, 45 s / 10 Mo, et citations web DATÉES (une copie du jour, jamais
# re-fetchée à l'affichage).

# ===== Conversation : workspace local (Phase 6, AC3) =====
# Racine unique que l'agent a le droit de LIRE, en LECTURE SEULE. Vide (défaut) : l'outil
# `read_file` n'existe pas et n'est jamais annoncé au modèle — même construction que le web
# sans connecteur, et une Phase 6 complète sans lui.
#
# Le confinement est appliqué à chaque lecture : chemin résolu, liens symboliques résolus,
# refus si le résultat sort de cette racine ; texte seulement, ≤ 256 Ko par lecture, aucune
# écriture, aucune énumération de dossier. Une citation de fichier est écrite
# `chemin:ligne` et REVÉRIFIÉE à chaque affichage (contrairement à une copie web, qui est
# datée) : le fichier est local, le relire ne coûte rien et ne sort de nulle part.
#
# Exemple (Windows) : WORKSPACE_ROOT=C:/Users/moi/Documents/notes
# Exemple (POSIX)  : WORKSPACE_ROOT=/home/moi/notes
WORKSPACE_ROOT=
