# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# identifiants locaux de l'outillage
/.freebuff/

# fichiers d'agent (AGENTS.md est regenere par `next dev` a chaque lancement)
/AGENTS.md
/CLAUDE.md
/.agents/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# données locales (sources, base SQLite, rapports d'évaluation)
/data/*
# exception : le manifeste de validation est un artefact de protocole (12 docs / 5 domaines)
!/data/corpus_manifest.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
